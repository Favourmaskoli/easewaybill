
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  RIDER     // delivers goods from seller to buyer
  ADMIN     // platform management, dispute resolution
}

enum OrderStatus {
  DRAFT               // seller created, not yet sent to buyer
  PENDING_BUYER       // waiting for buyer to confirm order details
  AWAITING_PAYMENT    // buyer confirmed, waiting for payment
  PAID                // escrow funded, seller can now ship
  SHIPPED             // seller handed goods to rider
  IN_TRANSIT          // rider picked up, en route to buyer
  DELIVERED           // rider delivered to buyer
  COMPLETED           // buyer confirmed satisfaction, funds released
  DISPUTED            // dispute raised by buyer or seller
  CANCELLED           // cancelled before payment
  REFUNDED            // buyer refunded after dispute resolution
}

enum WaybillStatus {
  GENERATED
  PRINTED
  ATTACHED
  VOID
}

enum EscrowStatus {
  PENDING             // payment not yet made
  HOLDING             // funds confirmed and locked in escrow
  PARTIALLY_RELEASED  // partial release (future: milestone payments)
  RELEASED            // full amount released to seller
  REFUNDED            // full amount returned to buyer
  DISPUTED            // frozen during active dispute
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionType {
  ESCROW_HOLD         // buyer pays in — funds locked
  PARTIAL_RELEASE     // partial release to seller
  FULL_RELEASE        // buyer confirms satisfaction — seller paid
  REFUND              // dispute resolved for buyer — buyer refunded
  DISPUTE_HOLD        // funds frozen during dispute
  DISPUTE_RESOLUTION  // admin resolves dispute
  PLATFORM_FEE        // platform commission deducted
}

enum NotificationType {
  ORDER_CREATED           // seller created order
  ORDER_SENT_TO_BUYER     // buyer notified to confirm
  ORDER_CONFIRMED_BUYER   // buyer confirmed order details
  ORDER_PAYMENT_PENDING   // buyer yet to pay
  ORDER_PAID              // escrow funded
  ORDER_SHIPPED           // seller shipped goods
  ORDER_PICKED_UP         // rider picked up goods
  ORDER_IN_TRANSIT        // rider en route
  ORDER_DELIVERED         // rider delivered to buyer
  ORDER_COMPLETED         // buyer confirmed satisfaction
  ORDER_CANCELLED         // order cancelled
  ORDER_DISPUTED          // dispute raised
  ESCROW_FUNDED           // payment confirmed in escrow
  ESCROW_RELEASED         // funds released to seller
  ESCROW_REFUNDED         // funds returned to buyer
  PAYMENT_SUCCESS         // Paystack payment confirmed
  PAYMENT_FAILED          // Paystack payment failed
  WAYBILL_GENERATED       // waybill created
  DISPUTE_OPENED          // dispute created
  DISPUTE_RESOLVED        // admin resolved dispute
  ACCOUNT_VERIFIED        // email/identity verified
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_FOR_BUYER
  RESOLVED_FOR_SELLER
  CLOSED
}

enum DisputeReason {
  ITEM_NOT_RECEIVED
  ITEM_DAMAGED
  ITEM_NOT_AS_DESCRIBED
  WRONG_ITEM_SENT
  SELLER_NOT_SHIPPING
  OTHER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

// ─────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  role                  UserRole  @default(USER)
  isEmailVerified       Boolean   @default(false)
  accountStatus AccountStatus @default(ACTIVE)
  avatarUrl             String?

  // Auth
  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  // Seller-specific — for Paystack transfer (payout)
  businessName          String?
  bankAccountName       String?
  bankAccountNumber     String?
  bankCode              String?   // Paystack bank code

  // Rider-specific
  vehicleType           String?
  vehiclePlate          String?
  isAvailable           Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  ordersAsSeller        Order[]             @relation("SellerOrders")
  ordersAsBuyer         Order[]             @relation("BuyerOrders")
  ordersAsRider         Order[]             @relation("RiderOrders")
  notifications         Notification[]
  escrowTransactions    EscrowTransaction[] @relation("TransactionActor")
  disputesRaised        Dispute[]           @relation("DisputeRaisedBy")
  disputesResolved      Dispute[]           @relation("DisputeResolvedBy")
  transferRecipient TransferRecipient?

  @@index([email])
  @@index([role])
  // @@index([isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────────────────────────────

model Order {
  id               String       @id @default(cuid())
  trackingCode     String       @unique

  status           OrderStatus  @default(DRAFT)
  description      String
  weight           Decimal?     @db.Decimal(8, 2)
  dimensions       String?
  fragile          Boolean      @default(false)

  // Pickup (seller's address / warehouse)
  pickupAddress    String
  pickupLat        Decimal?     @db.Decimal(10, 7)
  pickupLng        Decimal?     @db.Decimal(10, 7)

  // Delivery (buyer's address)
  deliveryAddress  String
  deliveryLat      Decimal?     @db.Decimal(10, 7)
  deliveryLng      Decimal?     @db.Decimal(10, 7)

  // Buyer info (may be pre-filled before buyer registers)
  buyerEmail       String       // used to notify buyer
  buyerName        String?      // filled from profile once buyer confirms
  buyerPhone       String?

  // Financials — agreed between buyer and seller
  itemPrice        Decimal      @db.Decimal(12, 2)  // price of goods
  deliveryFee      Decimal      @default(0) @db.Decimal(12, 2)  // shipping cost
  totalAmount      Decimal      @db.Decimal(12, 2)  // itemPrice + deliveryFee
  platformFee      Decimal      @default(0) @db.Decimal(12, 2)  // EaseWaybill commission
  sellerPayout     Decimal      @default(0) @db.Decimal(12, 2)  // totalAmount - platformFee
  riderPayout      Decimal      @default(0) @db.Decimal(12, 2)  // delivery fee portion

  // Escrow
  escrowStatus     EscrowStatus @default(PENDING)

  // Participants
  sellerId         String
  seller           User         @relation("SellerOrders", fields: [sellerId], references: [id])

  buyerId          String?      // null until buyer confirms and registers/logs in
  buyer            User?        @relation("BuyerOrders", fields: [buyerId], references: [id])

  riderId          String?      // null until seller ships
  rider            User?        @relation("RiderOrders", fields: [riderId], references: [id])

  transferRecords TransferRecord[]

  // Timestamps for each state transition
  sentToBuyerAt        DateTime?  // seller sent to buyer for confirmation
  buyerConfirmedAt     DateTime?  // buyer confirmed order details
  paidAt               DateTime?  // escrow funded
  shippedAt            DateTime?  // seller handed to rider
  pickedUpAt           DateTime?  // rider picked up
  deliveredAt          DateTime?  // rider delivered to buyer
  completedAt          DateTime?  // buyer confirmed satisfaction
  cancelledAt          DateTime?
  disputedAt           DateTime?
  refundedAt           DateTime?


  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  items              OrderItem[]
  waybills           Waybill[]
  escrowTransactions EscrowTransaction[]
  notifications      Notification[]
  dispute            Dispute?
  paymentRecords PaymentRecord[]

  @@index([trackingCode])
  @@index([sellerId])
  @@index([buyerId])
  @@index([riderId])
  @@index([status])
  @@index([escrowStatus])
  @@index([buyerEmail])
  @@index([createdAt])
  @@map("orders")
}

// ─────────────────────────────────────────────────────────────────
// ORDER ITEM
// ─────────────────────────────────────────────────────────────────

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal? @db.Decimal(12, 2)  // price per unit
  weight      Decimal? @db.Decimal(8, 2)
  fragile     Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────
// WAYBILL
// ─────────────────────────────────────────────────────────────────

model Waybill {
  id              String        @id @default(cuid())
  waybillNumber   String        @unique
  status          WaybillStatus @default(GENERATED)

  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  events        WaybillEvent[]

  // Denormalised snapshot — stable even if addresses/names change later
  sellerName      String
  sellerPhone     String
  sellerAddress   String
  buyerName       String
  buyerPhone      String
  buyerAddress    String
  description     String
  weight          Decimal?      @db.Decimal(8, 2)
  dimensions      String?
  declaredValue   Decimal?      @db.Decimal(12, 2)
  fragile         Boolean       @default(false)
  notes           String?

  pdfUrl          String?       // Cloudinary/S3 URL after generation

  generatedAt     DateTime      @default(now())
  printedAt       DateTime?
  voidedAt        DateTime?
  voidReason      String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([waybillNumber])
  @@index([status])
  @@map("waybills")
}

// ─────────────────────────────────────────────────────────────────
// WAYBILL EVENT (tracking timeline)
// ─────────────────────────────────────────────────────────────────

model WaybillEvent {
  id           String   @id @default(cuid())

  waybillId    String
  waybill      Waybill  @relation(fields: [waybillId], references: [id])

  status       String
  note         String?
  location     String?
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  scannedById  String?

  createdAt    DateTime @default(now())

  @@index([waybillId])
  @@index([createdAt])
  @@map("waybill_events")
}

// ─────────────────────────────────────────────────────────────────
// ESCROW TRANSACTION
// ─────────────────────────────────────────────────────────────────

model EscrowTransaction {
  id               String          @id @default(cuid())

  orderId          String
  order            Order           @relation(fields: [orderId], references: [id])

  type             TransactionType
  paymentStatus    PaymentStatus   @default(PENDING)

  amount           Decimal         @db.Decimal(12, 2)
  currency         String          @default("NGN")
  reference        String          @unique   // internal reference
  paystackRef      String?                   // Paystack transaction reference
  paystackResponse Json?                     // raw Paystack webhook payload

  // Who triggered this transaction
  actorId          String?
  actor            User?           @relation("TransactionActor", fields: [actorId], references: [id])

  note             String?
  metadata         Json?

  processedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([orderId])
  @@index([reference])
  @@index([paymentStatus])
  @@index([type])
  @@index([actorId])
  @@map("escrow_transactions")
}

// ─────────────────────────────────────────────────────────────────
// DISPUTE
// ─────────────────────────────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())

  orderId     String        @unique  // one dispute per order
  order       Order         @relation(fields: [orderId], references: [id])

  raisedById  String
  raisedBy    User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])

  reason      DisputeReason
  description String
  evidence    Json?         // array of image URLs / document URLs

  status      DisputeStatus @default(OPEN)

  resolvedById   String?
  resolvedBy     User?      @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([raisedById])
  @@map("disputes")
}

// ─────────────────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())

  userId    String
  user      User                @relation(fields: [userId], references: [id])

  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])

  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  Json?

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────
// ESCROW AUDIT LOG
// ─────────────────────────────────────────────────────────────────

model EscrowAuditLog {
  id          String   @id @default(cuid())

  orderId     String
  actorId     String?  // user who triggered — null for system/auto
  action      String   // HOLD | RELEASE | REFUND | AUTO_RELEASE | DISPUTE_HOLD
  fromStatus  String   // escrowStatus before
  toStatus    String   // escrowStatus after
  amount      Decimal  @db.Decimal(12, 2)
  reference   String?  // payment/release reference
  note        String?
  metadata    Json?    // extra context

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("escrow_audit_logs")
}

// ─────────────────────────────────────────────────────────────────
// PAYMENT RECORD
// ─────────────────────────────────────────────────────────────────

enum PaymentChannel {
  CARD
  BANK_TRANSFER
  USSD
  QR
  MOBILE_MONEY
  UNKNOWN
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

model PaymentRecord {
  id            String              @id @default(cuid())

  orderId       String
  order         Order               @relation(fields: [orderId], references: [id])

  reference     String              @unique  // Paystack reference
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("NGN")
  channel       PaymentChannel      @default(UNKNOWN)
  status        PaymentRecordStatus @default(PENDING)

  authorizationUrl String?          // Paystack redirect URL
  accessCode       String?          // Paystack access code
  paystackId       String?          // Paystack transaction ID after verification

  initiatedBy   String?            // buyer userId
  verifiedAt    DateTime?
  paystackData  Json?               // raw Paystack response

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([orderId])
  @@index([reference])
  @@index([status])
  @@map("payment_records")
}

// ─────────────────────────────────────────────────────────────────
// TRANSFER RECORD
// ─────────────────────────────────────────────────────────────────

enum TransferRecordStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
  ABANDONED
}

model TransferRecord {
  id              String               @id @default(cuid())

  orderId         String
  order           Order                @relation(fields: [orderId], references: [id])

  recipientId     String
  recipient       TransferRecipient    @relation(fields: [recipientId], references: [id])

  reference       String               @unique
  transferCode    String?              // Paystack transfer_code
  amount          Decimal              @db.Decimal(12, 2)
  currency        String               @default("NGN")
  status          TransferRecordStatus @default(PENDING)
  reason          String?

  paystackData    Json?
  failureReason   String?

  initiatedAt     DateTime             @default(now())
  completedAt     DateTime?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderId])
  @@index([reference])
  @@index([status])
  @@map("transfer_records")
}

// ─────────────────────────────────────────────────────────────────
// TRANSFER RECIPIENT (cached Paystack recipient per user)
// ─────────────────────────────────────────────────────────────────

model TransferRecipient {
  id            String   @id @default(cuid())

  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  recipientCode String   @unique  // Paystack recipient_code
  accountName   String
  accountNumber String
  bankCode      String
  bankName      String
  currency      String   @default("NGN")

  paystackData  Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transfers     TransferRecord[]

  @@index([userId])
  @@map("transfer_recipients")
}