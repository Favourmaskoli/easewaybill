# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/easewaybill

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Throttle / Rate Limiting ─────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Paystack ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ─── Cloudinary (for file uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (Mailtrap for dev) ─────────────────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@easewaybill.com
EMAIL_FROM_NAME=EaseWaybill



# ─── Redis (Bull queue) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ─── Redis (Bull queue) ───────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
